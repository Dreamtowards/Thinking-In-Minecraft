    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.8",
    "katex": "^0.18.7",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.1.12"
  },
